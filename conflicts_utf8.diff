 +
 +const insertOrder = async (session) => {
 +  const today = todayInTimezone();
 +
 +  // Modo modificacion: actualizar detalle existente
 +  if (session.mode === 'modify' && session.orderId) {
 +    const tipoAlm = session.tipoAlmuerzo || {};
