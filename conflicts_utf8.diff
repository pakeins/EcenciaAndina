 +  const product = await (async () => {
 +    if (tipoAlm.nombreProducto) {
 +      const { data } = await adminClient
 +        .from('productos')
 +        .select('id_producto,nombre_producto,precio_unitario')
 +        .ilike('nombre_producto', tipoAlm.nombreProducto)
 +        .limit(1)
 +        .maybeSingle();
 +      if (data) return data;
