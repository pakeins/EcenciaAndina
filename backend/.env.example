PORT=3001

# Origenes permitidos para consumir la API desde navegador.
# En produccion/preproduccion agrega la URL real del frontend, por ejemplo:
# CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
AGREEMENT_DOCUMENTS_BUCKET=eciencia-agreement-documents

# n8n: webhook que dispara el envio manual del menu desde el tablero.
N8N_MENU_WEBHOOK_URL=http://localhost:7000/webhook/eciencia-enviar-menu-manual
N8N_MENU_WEBHOOK_SECRET=CAMBIA_ESTE_SECRETO_MANUAL

# Telegram webhook recibido por el backend.
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CAMBIA_ESTE_SECRETO_WEBHOOK
TELEGRAM_BOT_USERNAME=TU_BOT_SIN_ARROBA
TELEGRAM_PRIVACY_CONTACT=privacidad@example.com
TELEGRAM_PRIVACY_POLICY_URL=https://tu-frontend.run.app/privacidad
TELEGRAM_CONSENT_VERSION=EC-LOPDP-2026-06
TELEGRAM_INVITE_TOKEN_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
PUBLIC_BACKEND_URL=https://tu-backend-cloud-run.run.app
TELEGRAM_WEBHOOK_URL=https://tu-backend-cloud-run.run.app/api/telegram/webhook
AUTH_RATE_LIMIT=30
TELEGRAM_WEBHOOK_RATE_LIMIT=120

# Invitaciones Telegram por correo. Si RESEND_API_KEY o INVITATION_FROM_EMAIL
# estan vacios, el alta continua y devuelve email_delivery.status=not_configured.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=Eciencia Andina <invitaciones@tu-dominio.com>
INVITATION_REPLY_TO=soporte@tu-dominio.com

# URL publica del formulario de recuperacion registrada en Supabase Auth.
PASSWORD_RECOVERY_REDIRECT_URL=http://localhost:3000/login

# Reporteria
REPORT_TIMEZONE=America/Bogota
REPORT_LUNCH_CATEGORY_IDS=1
REPORT_CONSUMED_STATE_ID=2

# Retencion de imagenes generadas para menus de Telegram.
MENU_IMAGE_RETENTION_DAYS=14

# Aprovisionamiento inicial. Solo se usan con npm run db:provision-admin.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA
FIRST_ADMIN_USERNAME=Admin
FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_LAST_NAME=Principal

# Opcional para mantenimiento/admin local. No lo necesita el backend en runtime normal.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
